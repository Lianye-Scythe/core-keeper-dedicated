# Copy to core.env (git-ignored). Keep private IDs/passwords/webhooks out of Git.
# Use the numeric IDs of the host account that owns the data directories.
PUID=1000
PGID=1000
WORLD_INDEX=0
WORLD_NAME=Core Keeper Server
# Leave empty for the game to generate a join ID, or use your own valid ID.
GAME_ID=
MAX_PLAYERS=8
ACTIVATE_ALL_CONTENT=false

# Ordinary startup checks/downloads are enabled unless the host updater is set up.
# Change to true ONLY after following the scheduled-maintenance instructions.
UPDATE_GATE_ENABLED=false

# Persistent directories do not enable experimental FEX disk caches.
# Mesa's limit is a driver-managed disk budget, not a RAM reservation.
MESA_SHADER_CACHE_MAX_SIZE=512M

# Optional features remain disabled. Do not publish credentials in this file.
MODS_ENABLED=false
DISCORD_PLAYER_JOIN_ENABLED=false
DISCORD_PLAYER_LEAVE_ENABLED=false
DISCORD_SERVER_START_ENABLED=false
DISCORD_SERVER_STOP_ENABLED=false
