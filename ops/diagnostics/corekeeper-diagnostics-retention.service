[Unit]
Description=Bound Core Keeper historical logs and manual diagnostic evidence
After=docker.service
# Storage dependencies are generated by install.sh from the host configuration.

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/corekeeper-diagnostics-retention
UMask=0077
Nice=15
IOSchedulingClass=idle
MemoryMax=128M
TimeoutStartSec=180
NoNewPrivileges=true
ProtectSystem=strict
# Writable storage paths are supplied by the generated drop-in.
