[Unit]
Description=Bounded Core Keeper network and CPU evidence (observe only)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
RequiresMountsFor=/data/corekeeper

[Service]
Type=simple
ExecStart=/usr/local/libexec/corekeeper-network-evidence
Restart=on-failure
RestartSec=10
UMask=0077
Nice=10
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/data/corekeeper/diagnostics/network

[Install]
WantedBy=multi-user.target
