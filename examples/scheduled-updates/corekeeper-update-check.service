[Unit]
Description=Check FEX Core Keeper game and image updates; apply at the maintenance window
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=COREKEEPER_UPDATE_CONFIG=/etc/corekeeper-update-check.json
ExecStart=/usr/local/sbin/corekeeper-update-check
TimeoutStartSec=60min
UMask=0077
