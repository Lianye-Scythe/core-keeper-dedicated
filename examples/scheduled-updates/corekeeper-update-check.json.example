{
  "base": "/srv/corekeeper",
  "container": "core-keeper-dedicated",
  "image": "ghcr.io/lianye-scythe/core-keeper-dedicated:fex",
  "timezone": "UTC",
  "maintenance_hour": 4,
  "backup_keep": 2,
  "readiness_timeout": 1200,
  "required_mountpoint": "/",
  "readiness_helper": "/usr/local/libexec/corekeeper-ready"
}
